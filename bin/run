#!/usr/bin/env bash
set -euo pipefail

# Trouve le vrai chemin du script même s'il est lié via un symlink npm global
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

LIB_DIR="${SCRIPT_DIR}/../lib"
TARGET_DIR="$(pwd)"

subcommand="${1:-}"
shift || true

case "$subcommand" in
  init)
    exec bash "${LIB_DIR}/init-supabase.sh" init "$@"
    ;;
  down)
    PROJECT_NAME="${1:-}"
    if [[ -n "$PROJECT_NAME" ]]; then
      echo "Arrêt et nettoyage des conteneurs pour le projet : ${PROJECT_NAME}..."
      docker compose -p "${PROJECT_NAME}" down --volumes --remove-orphans 2>/dev/null || \
      docker-compose -p "${PROJECT_NAME}" down --volumes --remove-orphans 2>/dev/null || true
    elif [[ -f "${TARGET_DIR}/docker-compose.yml" ]]; then
      echo "Arrêt des services Supabase locaux dans le dossier courant..."
      docker compose down --volumes --remove-orphans 2>/dev/null || \
      docker-compose down --volumes --remove-orphans 2>/dev/null || true
    else
      echo "Erreur : Aucun fichier docker-compose.yml trouvé et aucun nom de projet spécifié."
      exit 1
    fi
    ;;
  logs)
    PROJECT_NAME="${1:-}"
    if [[ -n "$PROJECT_NAME" ]]; then
      echo "Affichage des logs pour le projet : ${PROJECT_NAME}..."
      docker compose -p "${PROJECT_NAME}" logs -f 2>/dev/null || \
      docker-compose -p "${PROJECT_NAME}" logs -f 2>/dev/null || \
      echo "Erreur : Impossible de récupérer les logs pour le projet ${PROJECT_NAME}."
    elif [[ -f "${TARGET_DIR}/docker-compose.yml" ]]; then
      echo "Affichage des logs du projet dans le dossier courant..."
      docker compose logs -f 2>/dev/null || \
      docker-compose logs -f
    else
      echo "Erreur : Aucun fichier docker-compose.yml trouvé dans ce dossier et aucun nom de projet spécifié."
      echo "Usage: supabase-setup-cli logs [project-name]"
      exit 1
    fi
    ;;
  -h|--help|help)
    echo "Usage: supabase-setup-cli <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init name=<name> port=<port> storage-port=<port>  Initialize a new Supabase project"
    echo "  down [project-name]                               Stop local Supabase services & remove containers"
    echo "  logs [project-name]                               View container logs in real time"
    exit 0
    ;;
  *)
    echo "Unknown or missing command: $subcommand"
    echo "Usage: supabase-setup-cli init name=<name> port=<port> storage-port=<port>"
    exit 1
    ;;
esac
